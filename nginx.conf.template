# =============================================================================
# nginx Configuration Template for OpenClaw Authentication Proxy
#
# This template is used by the docker-entrypoint.sh script to generate the
# final nginx configuration. The variables ${ORIGIN} and ${TOKEN} will be
# substituted with actual values from the environment.
#
# Key Features:
# - Reverse proxy to OpenClaw backend
# - Bearer token injection for API authentication
# - WebSocket support for real-time connections
# - Optional HTTP Basic Authentication
# - HTTP/2 support
# =============================================================================

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # =================================================================
    # Logging Configuration
    # =================================================================

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    # =================================================================
    # Performance Tuning
    # =================================================================

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 50M;

    # =================================================================
    # Upstream Backend Configuration
    #
    # Defines the OpenClaw backend service that will handle requests
    # =================================================================

    upstream backend {
        server ${ORIGIN};
        keepalive 32;
    }

    # =================================================================
    # HTTP Server Configuration
    #
    # Listens on port 80 and forwards requests to the OpenClaw backend
    # with Bearer token authentication
    # =================================================================

    server {
        listen 80 default_server;
        listen [::]:80 default_server;

        server_name _;

        # =============================================================
        # HTTP Basic Authentication (if configured)
        # =============================================================

        # Uncomment these lines if BASIC_AUTH environment variable is set
        # auth_basic "Restricted Access";
        # auth_basic_user_file /etc/nginx/.htpasswd;

        # =============================================================
        # API Endpoints: Proxy with Bearer Token Authentication
        #
        # All requests are forwarded to the OpenClaw backend with:
        # 1. Bearer token in Authorization header
        # 2. Original request headers
        # 3. WebSocket upgrade support
        # =============================================================

        location / {
            # =========================================================
            # Proxy Configuration
            # =========================================================

            # Forward requests to the OpenClaw backend
            proxy_pass http://backend;

            # Preserve the Host header from the original request
            proxy_set_header Host $host;

            # Add the Bearer token for OpenClaw authentication
            # ${TOKEN} is substituted by docker-entrypoint.sh with the
            # actual OPENCLAW_GATEWAY_TOKEN value
            proxy_set_header Authorization "Bearer ${TOKEN}";

            # Forward client information
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # =========================================================
            # WebSocket Support
            # ==========================================================

            # Required headers for WebSocket upgrade
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            # Disable buffering for real-time WebSocket connections
            proxy_buffering off;
            proxy_request_buffering off;

            # =========================================================
            # Timeout Configuration
            # =========================================================

            # Connection timeout to backend
            proxy_connect_timeout 60s;

            # Read timeout for responses
            proxy_read_timeout 60s;

            # Send timeout for requests
            proxy_send_timeout 60s;

            # WebSocket specific timeouts
            proxy_socket_keepalive on;
        }

        # =============================================================
        # Health Check Endpoint
        #
        # Returns 200 OK - used by load balancers and monitoring
        # =============================================================

        location /health {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }

        # =============================================================
        # Metrics/Status Endpoint (internal only)
        #
        # Shows nginx status information
        # =============================================================

        location /nginx_status {
            stub_status on;
            access_log off;
            allow 127.0.0.1;
            allow ::1;
            deny all;
        }
    }
}
